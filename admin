<script>
    // Link API chính chủ của KTA.Teams
    const API_URL = 'https://script.google.com/macros/s/AKfycbzOZgNrN2ynajhIq-5HM1dp6SgoUhc353H8s3sjbGuajyYRj6AS2B6o5QJBhJCkjtg/exec';

    async function fetchSessions() {
        const list = document.getElementById('sessionList');
        const loader = document.getElementById('loading');
        
        loader.style.display = 'block';
        list.innerHTML = '';

        try {
            // Lấy dữ liệu từ Sheets về
            const response = await fetch(API_URL);
            const data = await response.json();
            
            loader.style.display = 'none';
            renderSessions(data); 

        } catch (error) {
            loader.innerText = 'Lỗi kết nối đến Server KTA! Vui lòng tải lại trang.';
            console.error(error);
        }
    }

    function renderSessions(data) {
        const list = document.getElementById('sessionList');
        
        if (!data || data.length === 0) {
            list.innerHTML = '<div style="text-align:center; color:#94a3b8; padding: 20px;">Hiện chưa có kèo nào được tạo.</div>';
            return;
        }

        // Đảo ngược để kèo mới nhất hiện lên trên
        data.reverse().forEach(session => {
            // Lấy tạm max là số, current tạm để 0 (sau này nâng cấp tính năng đếm người sau)
            const btnHTML = `<button class="btn-join" onclick="alert('Tính năng xin slot sẽ cập nhật sau!')">Xin Slot</button>`;

            list.innerHTML += `
                <div class="session-card">
                    <div class="session-header">
                        <div class="host-name">👑 Host: ${session.Host}</div>
                        <div class="status-open">${session.Status}</div>
                    </div>
                    <div class="info-row">⏰ Thời gian: <span>${session.Time}</span></div>
                    <div class="info-row">📍 Địa điểm: <span>${session.Location}</span></div>
                    <div class="info-row">🏸 Loại cầu: <span>${session.Shuttlecock}</span></div>
                    <div class="info-row">📊 Trình độ: <span>${session.ReqLevel}</span></div>
                    <div class="info-row">👥 Đội hình: <span>Max ${session.Max} người</span></div>
                    ${btnHTML}
                </div>
            `;
        });
    }

    // Chạy khi mở web
    fetchSessions();
</script>
