<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>KTA Badminton | Tìm Kèo Giao Lưu</title>
    <style>
        :root {
            --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --accent: #10b981;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        body { background: var(--bg); color: var(--text); padding: 16px; padding-bottom: 80px; }
        
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
        .header h1 { font-size: 20px; color: #38bdf8; }
        .user-badge { background: #334155; padding: 6px 12px; border-radius: 20px; font-size: 14px; font-weight: bold; }

        .session-card {
            background: var(--card); padding: 16px; border-radius: 16px;
            margin-bottom: 16px; border: 1px solid rgba(255,255,255,0.1);
        }
        .session-header { display: flex; justify-content: space-between; margin-bottom: 12px; }
        .host-name { font-weight: bold; color: #818cf8; }
        .status-open { color: var(--accent); font-size: 12px; font-weight: bold; padding: 4px 8px; background: rgba(16,185,129,0.1); border-radius: 8px; }
        
        .info-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 14px; color: #cbd5e1; }
        .info-row span { font-weight: 500; color: #fff; }
        
        .btn-join {
            width: 100%; padding: 12px; margin-top: 10px; border: none; border-radius: 10px;
            background: #3b82f6; color: white; font-weight: bold; font-size: 16px; cursor: pointer;
        }
        .btn-join:active { transform: scale(0.98); }

        /* Loader khi đang lấy dữ liệu từ Google Sheets */
        .loader { text-align: center; color: #94a3b8; font-size: 14px; display: none; }
    </style>
</head>
<body>

    <div class="header">
        <h1>🏸 KTA Badminton</h1>
        <div class="user-badge" id="userInfo">Khách</div>
    </div>

    <div id="loading" class="loader">Đang tải kèo từ hệ thống...</div>
    
    <div id="sessionList">
        <!-- Danh sách kèo sẽ được JavaScript đẩy vào đây -->
    </div>

    <script>
        // TRÊN GITHUB SẼ DÙNG LINK NÀY (Sau khi bạn deploy Google Apps Script)
        const GOOGLE_API_URL = 'https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec';

        // Fake data để bạn test UI trên GitHub trước khi nối backend
        const mockData = [
            { id: 'S01', host: 'Tuấn An (Host)', time: '19:00 - 22:00 | 28/10', location: 'Sân Bình Minh (Sân 3)', level: 'TB- đến TB+', max: 8, current: 5, status: 'OPEN' },
            { id: 'S02', host: 'Host System', time: '18:00 - 20:00 | 29/10', location: 'Sân Viettel', level: 'Newbie - Yếu', max: 6, current: 6, status: 'FULL' }
        ];

        async function fetchSessions() {
            const list = document.getElementById('sessionList');
            const loader = document.getElementById('loading');
            
            loader.style.display = 'block';

            try {
                // Đóng cmt dòng dưới khi chạy thật với Google Sheets
                // const response = await fetch(GOOGLE_API_URL + '?action=getSessions');
                // const data = await response.json();
                
                // Tạm thời dùng mockData để test giao diện
                const data = mockData;

                setTimeout(() => { // Giả lập thời gian tải
                    loader.style.display = 'none';
                    renderSessions(data);
                }, 800);

            } catch (error) {
                loader.innerText = 'Lỗi kết nối đến máy chủ!';
            }
        }

        function renderSessions(data) {
            const list = document.getElementById('sessionList');
            list.innerHTML = '';

            data.forEach(session => {
                const isFull = session.current >= session.max;
                const btnHTML = isFull 
                    ? `<button class="btn-join" style="background: #475569; cursor: not-allowed;" disabled>Đã chốt sổ (${session.current}/${session.max})</button>`
                    : `<button class="btn-join" onclick="joinSession('${session.id}')">Xin Slot (${session.current}/${session.max})</button>`;

                list.innerHTML += `
                    <div class="session-card">
                        <div class="session-header">
                            <div class="host-name">👑 ${session.host}</div>
                            <div class="${isFull ? '' : 'status-open'}">${isFull ? 'ĐÃ ĐẦY' : 'ĐANG NHẬN'}</div>
                        </div>
                        <div class="info-row">⏰ Thời gian: <span>${session.time}</span></div>
                        <div class="info-row">📍 Địa điểm: <span>${session.location}</span></div>
                        <div class="info-row">📊 Trình độ: <span>${session.level}</span></div>
                        ${btnHTML}
                    </div>
                `;
            });
        }

        function joinSession(id) {
            // Check đăng nhập ở đây
            alert('Đang gửi yêu cầu xin slot cho kèo ' + id + '...');
            // Chỗ này sẽ viết lệnh fetch(POST) gửi lên Google Sheets
        }

        // Chạy hàm khi mở web
        fetchSessions();
    </script>
</body>
</html>
