<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Host Panel | KTA Badminton</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #10b981;
            --accent-hover: #059669;
            --danger: #ef4444;
            --border-radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            min-height: 100vh;
            padding: env(safe-area-inset-top) 16px env(safe-area-inset-bottom) 16px;
        }

        .container {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            padding: 20px 0 50px 0;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .header h2 {
            font-size: 20px;
            font-weight: 700;
            color: var(--accent);
            margin-bottom: 2px;
        }

        .header p {
            font-size: 12.5px;
            color: var(--text-muted);
        }

        .mod-badge {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent);
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .card {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            margin-bottom: 20px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .card-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: white;
            font-size: 14.5px;
            outline: none;
            transition: 0.2s;
        }

        .form-control:focus {
            border-color: var(--accent);
            background: rgba(255, 255, 255, 0.07);
        }

        select.form-control {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
            padding-right: 40px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .btn-primary {
            width: 100%;
            height: 48px;
            margin-top: 10px;
            border: none;
            border-radius: 12px;
            background: var(--accent);
            color: white;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }

        .btn-primary:active {
            transform: scale(0.97);
            background: var(--accent-hover);
        }

        .nav-links {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .nav-links a {
            color: #60a5fa;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
        }

        .nav-links a:hover {
            text-decoration: underline;
        }

        #toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #1e293b;
            color: #fff;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 13.5px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            border: 1px solid rgba(255,255,255,0.15);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 2000;
        }

        #toast.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="header">
            <div>
                <h2>KTA Host Panel</h2>
                <p>Tạo và quản lý buổi đánh cầu</p>
            </div>
            <div class="mod-badge">MOD / HOST</div>
        </div>

        <div class="card">
            <div class="card-title">🏸 Phát Lịch Đánh Mới</div>
            <form id="createSessionForm" onsubmit="createSession(event)">
                
                <div class="form-group">
                    <label>Thời gian (Giờ & Ngày)</label>
                    <input type="text" id="time" class="form-control" placeholder="VD: 19:00 - 22:00 | T6 (28/10)" required>
                </div>
                
                <div class="form-group">
                    <label>Tên sân & Số sân</label>
                    <input type="text" id="location" class="form-control" placeholder="VD: Sân VinaSport, Sân số 3" required>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>Loại cầu sử dụng</label>
                        <select id="shuttlecock" class="form-control">
                            <option value="VinaStar">VinaStar</option>
                            <option value="Thành Công">Thành Công</option>
                            <option value="Lining A+">Lining A+</option>
                            <option value="Blue Swallow">Blue Swallow</option>
                            <option value="Khác">Cầu khác</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Số slot tối đa</label>
                        <input type="number" id="maxPlayers" class="form-control" placeholder="VD: 8" required min="2" max="20" value="8">
                    </div>
                </div>

                <div class="form-group">
                    <label>Yêu cầu trình độ</label>
                    <input type="text" id="reqLevel" class="form-control" placeholder="VD: Từ Lvl 3 (TB Yếu) trở lên" required value="Từ Lvl 3 (TB Yếu) trở lên">
                </div>

                <button type="submit" class="btn-primary" id="createBtn">Đăng Kèo Lên Trang Chủ</button>
            </form>
        </div>

        <div class="nav-links">
            <a href="index.html">← Về Trang Chủ Xem Kèo</a>
            <a href="register.html">Đổi Hồ Sơ Cá Nhân →</a>
        </div>
    </div>

    <div id="toast">Thông báo</div>

    <script>
        const API_URL = 'https://script.google.com/macros/s/AKfycbzOZgNrN2ynajhIq-5HM1dp6SgoUhc353H8s3sjbGuajyYRj6AS2B6o5QJBhJCkjtg/exec';

        async function createSession(event) {
            event.preventDefault();

            const btn = document.getElementById('createBtn');
            btn.innerText = 'Đang đẩy kèo lên Google Sheets...';
            btn.disabled = true;

            // Lấy tên Host từ LocalStorage nếu có, không thì mặc định Kim Tuấn An hoặc Chủ Kèo
            let hostName = 'Kim Tuấn An (Host)';
            const savedUser = localStorage.getItem('kta_user');
            if (savedUser) {
                try {
                    const u = JSON.parse(savedUser);
                    hostName = `${u.name} (Host)`;
                } catch(e) {}
            }

            const newSession = {
                id: 'S_' + Date.now(),
                host: hostName,
                time: document.getElementById('time').value.trim(),
                location: document.getElementById('location').value.trim(),
                shuttlecock: document.getElementById('shuttlecock').value,
                max: document.getElementById('maxPlayers').value,
                level: document.getElementById('reqLevel').value.trim(),
                status: 'OPEN'
            };

            try {
                // Gửi POST request tới Google Apps Script API
                await fetch(API_URL + '?action=createSession', {
                    method: 'POST',
                    body: JSON.stringify(newSession),
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
                });

                showToast('✅ Phát kèo thành công lên trang chủ!');
                document.getElementById('createSessionForm').reset();

                setTimeout(() => {
                    window.location.href = 'index.html';
                }, 1200);

            } catch (err) {
                showToast('❌ Lỗi kết nối mạng, vui lòng thử lại!');
                btn.innerText = 'Đăng Kèo Lên Trang Chủ';
                btn.disabled = false;
            }
        }

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }
    </script>
</body>
</html>
